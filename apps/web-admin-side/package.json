{
  "name": "@dnc/web-admin",
  "version": "0.0.1",
  "private": true,
  "description": "Next.js 16 App Router operations console for Da Nang Connect staff (curator, moderator, admin, super admin). Presentation only: types come from @dnc/contracts, business rules from @dnc/domain, theme values from @dnc/tokens, strings from @dnc/i18n",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "gen:theme": "node scripts/generate-theme.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnc/contracts": "workspace:*",
    "@dnc/domain": "workspace:*",
    "@dnc/i18n": "workspace:*",
    "@dnc/tokens": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@dnc/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
