{
  "name": "@dnc/web-client",
  "version": "0.0.1",
  "private": true,
  "description": "Next.js 16 App Router client for expat users. Presentation only: types come from @dnc/contracts, theme values from @dnc/tokens, strings from @dnc/i18n",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen:theme": "node scripts/generate-theme.mjs",
    "copy:maplibre": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@dnc/contracts": "workspace:*",
    "@dnc/domain": "workspace:*",
    "@dnc/geo": "workspace:*",
    "@dnc/i18n": "workspace:*",
    "@dnc/tokens": "workspace:*",
    "maplibre-gl": "6.6.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@dnc/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
