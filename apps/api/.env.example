# Copy to .env and fill in. Values set in the shell take precedence over this file.

DATABASE_URL=postgresql://dnc:dnc@localhost:5433/dnc
PORT=3001

# S3-compatible object storage. MinIO locally (docker compose up -d minio).
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=dnc
S3_SECRET_KEY=dnc-local-only
S3_MEDIA_BUCKET=dnc-media

# RS256 key pair for access tokens, as single-line strings with \n escapes.
# Required in production; the service refuses to boot without them. Absent in
# development it generates an ephemeral pair, which signs every session out on
# each restart — pin a pair here to avoid that.
#   node -e "const {generateKeyPair,exportPKCS8,exportSPKI}=require('jose');..."
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Browser origins allowed to call the API directly (comma separated).
# The web client goes through a Next rewrite and needs none of these.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
