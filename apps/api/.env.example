# Copy to .env and fill in. Values set in the shell take precedence over this file.

DATABASE_URL=postgresql://dnc:dnc@localhost:5433/dnc
PORT=3001

# S3-compatible object storage. MinIO locally (docker compose up -d minio).
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY=dnc
S3_SECRET_KEY=dnc-local-only
S3_MEDIA_BUCKET=dnc-media

# Redis: two instances on purpose (see docker-compose.local.yml). The cache may
# evict keys; the queue must not, or BullMQ loses jobs.
REDIS_CACHE_URL=redis://localhost:6381
REDIS_QUEUE_URL=redis://localhost:6380

# SMTP. Mailpit locally (docker compose up -d mailpit), inbox at http://localhost:8025.
# Required in production; the service refuses to boot without SMTP_HOST.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Da Nang Connect <no-reply@danangconnect.local>"
# Staging only: comma-separated recipient domains mail may go to; others are skipped.
MAIL_ALLOWED_DOMAINS=

# RS256 key pair for access tokens, as single-line strings with \n escapes.
# Required in production; the service refuses to boot without them. Absent in
# development it generates an ephemeral pair, which signs every session out on
# each restart — pin a pair here to avoid that.
# The ephemeral pair is non-extractable and never logged, so generate a pinned
# pair with openssl and fold each PEM into one line with \n escapes:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#   awk 'NF {printf "%s\\n", $0}' jwt-private.pem   # value for JWT_PRIVATE_KEY
#   awk 'NF {printf "%s\\n", $0}' jwt-public.pem    # value for JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Browser origins allowed to call the API directly (comma separated).
# The web client goes through a Next rewrite and needs none of these.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Reverse-proxy trust, which decides what request.ip (and so the per-IP rate
# limits) means. Unset: 'loopback' in development; the service refuses to boot
# in production without it. Accepts a hop count (2) or a comma-separated list of
# loopback/linklocal/uniquelocal, IPs and CIDRs (10.0.0.0/8). 'true' is rejected
# because it trusts every X-Forwarded-For.
# The web apps reach the API through a Next rewrite, which forwards the client's
# X-Forwarded-For untouched and adds none of its own. Production therefore needs
# a reverse proxy in front of Next (for example nginx with
# `proxy_add_x_forwarded_for`) that appends the real client IP, and this value
# must trust loopback (Next) plus that proxy's hop count or CIDR, e.g.
# `loopback,10.0.0.0/8`. Without such a proxy every web user shares the
# address of Next, so one per-IP bucket is counted across all of them.
# TRUST_PROXY=loopback

# Auth rate limits (POST /auth/login and /auth/register), defaults shown.
# Login counts failed attempts only. Register counts every call per IP, on
# fixed 1-hour and 24-hour windows.
# RATE_LIMIT_LOGIN_IP_MAX=10
# RATE_LIMIT_LOGIN_IDENTIFIER_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_REGISTER_HOURLY_MAX=5
# RATE_LIMIT_REGISTER_DAILY_MAX=15
# Keys the HMAC that hashes IPs and identifiers inside Redis keys. Required in
# production (at least 32 characters, shared by every instance), e.g.:
#   openssl rand -hex 32
# Development generates a random one per boot.
# RATE_LIMIT_HMAC_SECRET=
# Local development and Playwright only, never in production: thresholds high
# enough that repeated test registrations do not lock the dev API out.
# RATE_LIMIT_LOGIN_IP_MAX=1000
# RATE_LIMIT_LOGIN_IDENTIFIER_MAX=1000
# RATE_LIMIT_REGISTER_HOURLY_MAX=1000
# RATE_LIMIT_REGISTER_DAILY_MAX=1000
