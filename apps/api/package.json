{
  "name": "@dnc/api",
  "version": "0.0.1",
  "private": true,
  "description": "NestJS API \u2014 modular monolith. Request/response contracts come from @dnc/contracts (Zod via Standard Schema)",
  "type": "module",
  "scripts": {
    "dev": "vite-node --watch src/main.ts",
    "start": "vite-node src/main.ts",
    "seed:areas": "vite-node src/database/seeds/seed-areas.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@dnc/contracts": "workspace:*",
    "@dnc/domain": "workspace:*",
    "@dnc/geo": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/platform-socket.io": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/websockets": "12.0.1",
    "@node-rs/argon2": "2.2.0",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@dnc/config": "workspace:*",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "unplugin-swc": "1.5.11",
    "vite-node": "6.0.0",
    "vitest": "4.1.11"
  }
}
